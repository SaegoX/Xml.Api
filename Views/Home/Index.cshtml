@{
    ViewData["Title"] = "Загрузка расписания";
}

<!-- Локальный скрипт SignalR -->
<script src="~/js/signalr.min.js"></script>

<!-- Форма загрузки -->
<form id="uploadForm">
    <div>
        <label style="font-weight: bold; display: block; margin-bottom: 8px;">Выберите XML-файл:</label>
        <input type="file" id="xmlFileInput" name="xmlFile" accept=".xml" required />
    </div>
    <button type="submit" id="submitBtn" style="margin-top: 12px; padding: 6px 12px; cursor: pointer;">Загрузить</button>
</form>

<!-- Контейнер единого прогресс-бара -->
<div id="progressContainer" style="display: none; margin-top: 20px; max-width: 400px;">
    <progress id="progressBar" value="0" max="100" style="width: 100%; height: 20px;"></progress>
    <p id="statusText" style="margin-top: 5px; font-size: 14px; color: #555; font-weight: bold;"></p>
</div>

<!-- Блок вывода результата -->
<div id="resultMessage" style="margin-top: 15px; font-weight: bold;"></div>

<script>
    let signalrConnection = null;

    window.addEventListener('DOMContentLoaded', function() {
        // Проверяем, не осталась ли в памяти браузера активная задача
        const savedJobId = localStorage.getItem('activeJobId');
        if (savedJobId) {
            const progressContainer = document.getElementById('progressContainer');
            const submitBtn = document.getElementById('submitBtn');
            const statusText = document.getElementById('statusText');

            submitBtn.disabled = true;
            progressContainer.style.display = "block";
            statusText.innerText = "Восстановление соединения с фоновой задачей...";

            // Восстанавливаем отслеживание SignalR и опрос статуса
            startSignalR(savedJobId);
        }
    });

    document.getElementById('uploadForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('xmlFileInput');
        if (fileInput.files.length === 0) return;

        const formData = new FormData();
        formData.append("xmlFile", fileInput.files[0]);

        const submitBtn = document.getElementById('submitBtn');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const statusText = document.getElementById('statusText');
        const resultMessage = document.getElementById('resultMessage');

        submitBtn.disabled = true;
        resultMessage.innerText = "";
        progressContainer.style.display = "block";
        progressBar.value = 0;
        statusText.innerText = "Передача XML-файла на веб-сервер...";

        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/Home/Upload", true);

        xhr.upload.onprogress = function(event) {
            if (event.lengthComputable) {
                const netPercent = Math.round((event.loaded / event.total) * 100);
                const totalPercent = Math.round(netPercent / 2);
                progressBar.value = totalPercent;
                statusText.innerText = `Передача XML-файла на веб-сервер... ${totalPercent}%`;
            }
        };

        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);
                    const jobId = response.jobId;

                    // СОХРАНЯЕМ ТОКЕН ЗАДАЧИ В ПАМЯТЬ БРАУЗЕРА (Защита от закрытия вкладки)
                    localStorage.setItem('activeJobId', jobId);

                    progressBar.value = 50;
                    statusText.innerText = "Файл принят сервером. Подключаемся к каналу базы данных... (50%)";

                    startSignalR(jobId);
                } catch (err) {
                    console.error("Ошибка парсинга ответа Upload:", err);
                    handleFinalResult(false, "Критическая ошибка формата JobId.");
                }
            } else {
                try {
                    const response = JSON.parse(xhr.responseText);
                    handleFinalResult(false, response.message || "Ошибка при загрузке файла.");
                } catch (e) {
                    handleFinalResult(false, "Внутренняя ошибка сервера при загрузке.");
                }
            }
        };

        xhr.onerror = function() {
            handleFinalResult(false, "Ошибка сети при отправке файла на сервер.");
        };

        xhr.send(formData);
    });

    function startSignalR(jobId) {
        const progressBar = document.getElementById('progressBar');
        const statusText = document.getElementById('statusText');

        signalrConnection = new signalR.HubConnectionBuilder()
            .withUrl("/schedule-hub")
            .withAutomaticReconnect()
            .build();

        signalrConnection.on("ReceiveProgress", function(percent, status) {
            progressBar.value = percent;
            statusText.innerText = status;
        });

        signalrConnection.on("ReceiveResult", function(isSuccess, message) {
            handleFinalResult(isSuccess, message);
        });

        signalrConnection.start()
            .then(function() {
                signalrConnection.invoke("SubscribeToJob", jobId)
                    .then(async function() {
                        try {
                            const response = await fetch(`/get-upload-status?jobId=${jobId}`);

                            // ЕСЛИ СЕРВЕР ПЕРЕЗАПУСКАЛСЯ: бэкенд вернет ошибку (задачи нет в RAM)
                            if (!response.ok) {
                                console.warn("Фоновая задача не найдена на сервере. Сбрасываем сессию.");
                                handleFinalResult(false, "Предыдущая фоновая сессия импорта была сброшена из-за перезапуска сервера.");
                                return;
                            }

                            const state = await response.json();

                            if (!state.isCompleted) {
                                progressBar.value = state.percent;
                                statusText.innerText = state.status;
                            }

                            if (state.isCompleted) {
                                const isSuccess = !state.errorMessage;
                                const msg = isSuccess ? state.status : `Ошибка: ${state.errorMessage}`;
                                handleFinalResult(isSuccess, msg);
                            }
                        } catch (err) {
                            console.error("Ошибка проверки статуса задачи:", err);
                            // Страховка при сбое сети: даем администратору шанс загрузить заново
                            handleFinalResult(false, "Не удалось восстановить связь с задачей. Попробуйте выполнить импорт заново.");
                        }
                    })
                    .catch(err => console.error("Ошибка вызова SubscribeToJob:", err.toString()));
            })
            .catch(function(err) {
                console.error("Не удалось запустить SignalR:", err.toString());
                handleFinalResult(false, "Ошибка подключения к каналу живых уведомлений.");
            });
    }

    function handleFinalResult(isSuccess, message) {
        const submitBtn = document.getElementById('submitBtn');
        const progressContainer = document.getElementById('progressContainer');
        const resultMessage = document.getElementById('resultMessage');
        const statusText = document.getElementById('statusText');
        const fileInput = document.getElementById('xmlFileInput');

        // ОЧИЩАЕМ КЛЮЧ ЗАДАЧИ ПОСЛЕ ОКОНЧАНИЯ, чтобы при следующем заходе страница была пустой
        localStorage.removeItem('activeJobId');

        submitBtn.disabled = false;
        progressContainer.style.display = "none";
        statusText.innerText = "";

        resultMessage.innerText = message;
        resultMessage.style.color = isSuccess ? "green" : "red";

        if (isSuccess) {
            fileInput.value = "";
        }

        if (signalrConnection) {
            signalrConnection.stop();
            signalrConnection = null;
        }
    }
</script>