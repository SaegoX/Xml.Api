@{
    ViewData["Title"] = "Загрузка расписания";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<form id="uploadForm">
    <div>
        <label style="font-weight: bold; display: block; margin-bottom: 8px;">Выберите XML-файл:</label>
        <input type="file" id="xmlFileInput" name="xmlFile" accept=".xml" required />
    </div>
    <button type="submit" id="submitBtn" style="margin-top: 12px; padding: 6px 12px; cursor: pointer;">Загрузить</button>
</form>

<div id="progressContainer" style="display: none; margin-top: 20px; max-width: 400px;">
    <progress id="progressBar" value="0" max="100" style="width: 100%; height: 20px;"></progress>
    <p id="statusText" style="margin-top: 5px; font-size: 14px; color: #555; font-weight: bold;"></p>
</div>

<div id="resultMessage" style="margin-top: 15px; font-weight: bold;"></div>

<script>
    let signalrConnection = null;

    document.getElementById('uploadForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('xmlFileInput');
        if (fileInput.files.length === 0) return;

        const formData = new FormData();
        formData.append("xmlFile", fileInput.files[0]);

        const submitBtn = document.getElementById('submitBtn');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const statusText = document.getElementById('statusText');
        const resultMessage = document.getElementById('resultMessage');

        submitBtn.disabled = true;
        resultMessage.innerText = "";
        progressContainer.style.display = "block";
        progressBar.value = 0;
        statusText.innerText = "Загрузка файла на сервер...";

        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/Home/Upload", true);

        xhr.onload = function() {
            if (xhr.status === 200) {
                const response = JSON.parse(xhr.responseText);
                const jobId = response.jobId;

                statusText.innerText = "Файл успешно принят...";

                startSignalR(jobId);
            } else {
                submitBtn.disabled = false;
                progressContainer.style.display = "none";
                const response = JSON.parse(xhr.responseText);
                resultMessage.innerText = response.message || "Ошибка при загрузке файла.";
                resultMessage.style.color = "red";
            }
        };

        xhr.onerror = function() {
            submitBtn.disabled = false;
            progressContainer.style.display = "none";
            resultMessage.innerText = "Ошибка сети при отправке файла.";
            resultMessage.style.color = "red";
        };

        xhr.send(formData);
    });

    function startSignalR(jobId) {
        const progressBar = document.getElementById('progressBar');
        const statusText = document.getElementById('statusText');
        const progressContainer = document.getElementById('progressContainer');
        const resultMessage = document.getElementById('resultMessage');
        const submitBtn = document.getElementById('submitBtn');
        const fileInput = document.getElementById('xmlFileInput');

        // Создаем подключение к хабу
        signalrConnection = new signalR.HubConnectionBuilder()
            .withUrl("/schedule-hub")
            .withAutomaticReconnect()
            .build();

        // Слушаем живые проценты парсинга
        signalrConnection.on("ReceiveProgress", function (percent, status) {
            progressBar.value = percent;
            statusText.innerText = status;
        });

        // Слушаем финал обработки
        signalrConnection.on("ReceiveResult", function (isSuccess, message) {
            handleFinalResult(isSuccess, message);
        });

        // Вспомогательная функция для отрисовки финала
        function handleFinalResult(isSuccess, message) {
            submitBtn.disabled = false;
            progressContainer.style.display = "none";
            resultMessage.innerText = message;
            resultMessage.style.color = isSuccess ? "green" : "red";
            if (isSuccess) fileInput.value = "";

            if (signalrConnection) {
                signalrConnection.stop();
            }
        }

        // Стартуем подключение
        signalrConnection.start()
            .then(function () {
                await signalrConnection.invoke("Subscribe", jobId);
                    .then(function() {
                        // ОПТИМИЗАЦИЯ: Сразу после подписки опрашиваем бэкенд о текущем статусе.
                        // Если воркер уже всё сделал — мы мгновенно заберем результат из памяти трекера!
                        fetch(`/get-upload-status?jobId=${jobId}`)
                            .then(response => response.json())
                            .then(state => {
                                if (state.isCompleted) {
                                    // Если задача уже завершена, берем данные и гасим анимацию
                                    const isSuccess = !state.errorMessage;
                                    const msg = isSuccess ? state.status : `Ошибка: ${state.errorMessage}`;
                                    handleFinalResult(isSuccess, msg);
                                }
                            })
                            .catch(err => console.error("Ошибка проверки статуса:", err));
                    })
                    .catch(err => console.error("Ошибка подписки на задачу:", err.toString()));
            })
            .catch(function (err) {
                console.error("Not able to start SignalR:", err.toString());
                statusText.innerText = "Ошибка подключения к каналу уведомлений.";
            });
    }
</script>